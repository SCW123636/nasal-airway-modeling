+                rc = executor.main(['--case', str(root), '--config', cfg_path,
+                                    '--force-unsanctioned', '--steps', 'simpleFoam'])
+            self.assertEqual(rc, 0)
+            manifest = json.loads((root / 'run_manifest.json').read_text())
+            self.assertTrue(manifest['contract']['forced'])
