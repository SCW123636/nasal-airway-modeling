<Slide style={{ width: 1280, height: 720, background: '#0A1A2F', padding: '24px 64px', position: 'relative', overflow: 'hidden', fontFamily: "'Source Han Sans SC','PingFang SC','Microsoft YaHei',sans-serif" }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 600, height: 600, background: 'radial-gradient(circle at 0% 0%, rgba(34,211,238,0.10) 0%, rgba(34,211,238,0) 68%)' }} />
    <Box style={{ position: 'absolute', bottom: 0, right: 0, width: 420, height: 420, background: 'radial-gradient(circle at 100% 100%, rgba(245,165,36,0.07) 0%, rgba(245,165,36,0) 68%)' }} />

    <Box style={{ position: 'relative', zIndex: 1, width: '100%', flexDirection: 'column' }}>
        <Box style={{ height: 92, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
            <Box style={{ flexDirection: 'column', gap: 6 }}>
                <Text style={{ fontSize: 15, fontWeight: 600, letterSpacing: 3, color: '#22D3EE' }}>03 / 一个月的协作故事</Text>
                <Text style={{ fontSize: 36, fontWeight: 700, color: '#E8F1FA', lineHeight: 1.2 }}>从 0 到全链：四个星期</Text>
            </Box>
            <Box style={{ width: 46, height: 46, borderRadius: 23, border: '2px solid rgba(34,211,238,0.55)', justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 13, fontWeight: 700, color: '#22D3EE' }}>Q3</Text>
            </Box>
        </Box>

        <Box style={{ height: 510, marginTop: 16, flexDirection: 'row', gap: 30 }}>
            <Box style={{ width: 330, flexDirection: 'column', justifyContent: 'center', gap: 16, padding: '26px 24px', background: 'linear-gradient(150deg, #14294A 0%, #0E2039 100%)', borderRadius: 12, border: '1px solid rgba(34,211,238,0.32)' }}>
                <Text style={{ fontSize: 15, fontWeight: 600, letterSpacing: 2, color: '#22D3EE' }}>协作机制</Text>
                <Text style={{ fontSize: 20, color: '#B7CBDD', lineHeight: 1.65 }}>
                    任务卡即合同：先立约、再执行；产物与判据全部落盘；<Text style={{ color: '#E8F1FA', fontWeight: 600 }}>未参与创作的人</Text>负责独立复验。
                </Text>
                <Box style={{ flexDirection: 'column', gap: 8, marginTop: 'auto', paddingTop: 16, borderTop: '1px solid rgba(139,166,193,0.24)' }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 10 }}>
                        <Text style={{ fontSize: 44, fontWeight: 800, color: '#22D3EE', lineHeight: 1 }}>59</Text>
                        <Text style={{ fontSize: 17, color: '#8BA6C1' }}>个编号任务</Text>
                    </Box>
                    <Text style={{ fontSize: 15, color: '#8BA6C1', lineHeight: 1.5 }}>每个结论都带可复现命令、原始日志与独立复验记录</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, flexDirection: 'column', gap: 10, justifyContent: 'center' }}>
                <Box style={{ flexDirection: 'row', gap: 18, padding: '12px 17px', background: 'linear-gradient(150deg, #14294A 0%, #0E2039 100%)', borderRadius: 10, border: '1px solid rgba(139,166,193,0.22)' }}>
                    <Box style={{ flexDirection: 'column', alignItems: 'center', width: 92 }}>
                        <Text style={{ fontSize: 15, fontWeight: 600, color: '#22D3EE' }}>第 1 周</Text>
                        <Text style={{ fontSize: 13, color: '#8BA6C1' }}>打通链路</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column', gap: 4 }}>
                        <Text style={{ fontSize: 19, fontWeight: 700, color: '#E8F1FA' }}>DCM → 自动分割 → STL</Text>
                        <Text style={{ fontSize: 15, color: '#8BA6C1', lineHeight: 1.5 }}>24 例中 21 例通过表面四门禁（水密 / 体积守恒 / 开口面积），患者例全过。</Text>
                    </Box>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 18, padding: '12px 17px', background: 'linear-gradient(150deg, #14294A 0%, #0E2039 100%)', borderRadius: 10, border: '1px solid rgba(139,166,193,0.22)' }}>
                    <Box style={{ flexDirection: 'column', alignItems: 'center', width: 92 }}>
                        <Text style={{ fontSize: 15, fontWeight: 600, color: '#22D3EE' }}>第 2 周</Text>
                        <Text style={{ fontSize: 13, color: '#8BA6C1' }}>求解首战</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column', gap: 4 }}>
                        <Text style={{ fontSize: 19, fontWeight: 700, color: '#E8F1FA' }}>体网格 + 首次 CFD：崩溃</Text>
                        <Text style={{ fontSize: 15, color: '#8BA6C1', lineHeight: 1.5 }}>首跑 Time = 260 报浮点异常；只改数值设置做单变量反证后 533 步稳定收敛。</Text>
                    </Box>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 18, padding: '12px 17px', background: 'linear-gradient(150deg, #14294A 0%, #0E2039 100%)', borderRadius: 10, border: '1px solid rgba(139,166,193,0.22)' }}>
                    <Box style={{ flexDirection: 'column', alignItems: 'center', width: 92 }}>
                        <Text style={{ fontSize: 15, fontWeight: 600, color: '#22D3EE' }}>第 3 周</Text>
                        <Text style={{ fontSize: 13, color: '#8BA6C1' }}>改判据</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column', gap: 4 }}>
                        <Text style={{ fontSize: 19, fontWeight: 700, color: '#E8F1FA' }}>判据重议与工具链核验</Text>
                        <Text style={{ fontSize: 15, color: '#8BA6C1', lineHeight: 1.5 }}>出口改双轨判据收口；圆管 9 格判别把「网格致命」锁到退化单元一类。</Text>
                    </Box>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 18, padding: '12px 17px', background: 'linear-gradient(150deg, #1B3A5C 0%, #12263F 100%)', borderRadius: 10, border: '1px solid rgba(245,165,36,0.36)' }}>
                    <Box style={{ flexDirection: 'column', alignItems: 'center', width: 92 }}>
                        <Text style={{ fontSize: 15, fontWeight: 600, color: '#F5A524' }}>第 4 周</Text>
                        <Text style={{ fontSize: 13, color: '#8BA6C1' }}>定标准</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column', gap: 4 }}>
                        <Text style={{ fontSize: 19, fontWeight: 700, color: '#E8F1FA' }}>域标准统一 + 全链对账</Text>
                        <Text style={{ fontSize: 15, color: '#8BA6C1', lineHeight: 1.5 }}>域改为「鼻腔 + 鼻咽 + 可见口咽」；b15 / b01 / b02 全链跑通并对账基线。</Text>
                    </Box>
                </Box>
            </Box>
        </Box>

        <Box style={{ height: 40, marginTop: 8, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', borderTop: '1px solid rgba(139,166,193,0.22)' }}>
            <Text style={{ fontSize: 14, color: '#8BA6C1' }}>数据落点：这一个月真正产出的不是三张图，而是一套「失败也要留下判据」的工程记录</Text>
            <Text style={{ fontSize: 14, color: '#8BA6C1' }}>11 / 18</Text>
        </Box>
    </Box>
</Slide>
