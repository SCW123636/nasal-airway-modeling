<Slide style={{ width: 1280, height: 720, background: '#0A1A2F', position: 'relative', overflow: 'hidden', fontFamily: "'Source Han Sans SC','PingFang SC','Microsoft YaHei',sans-serif" }}>
    <Image src="assets/cover_airway.png" style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, objectFit: 'cover' }} />
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, background: 'linear-gradient(90deg, rgba(10,26,47,0.97) 0%, rgba(10,26,47,0.90) 38%, rgba(10,26,47,0.35) 70%, rgba(10,26,47,0.72) 100%)' }} />
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 600, height: 600, background: 'radial-gradient(circle at 0% 0%, rgba(34,211,238,0.16) 0%, rgba(34,211,238,0) 68%)' }} />

    <Box style={{ position: 'relative', width: 1280, height: 720, padding: '64px 72px', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
            <Box style={{ width: 40, height: 3, background: '#22D3EE' }} />
            <Text style={{ fontSize: 15, fontWeight: 600, letterSpacing: 4, color: '#22D3EE' }}>NASAL CFD · 鼻腔功能客观化评估</Text>
        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
            <Box style={{ flexDirection: 'column', gap: 24, width: 620 }}>
                <Text style={{ fontSize: 72, fontWeight: 700, color: '#E8F1FA', lineHeight: 1.14, letterSpacing: -1 }}>
                    让鼻子重新<br /><span style={{ color: '#22D3EE' }}>「被感觉到」</span>
                </Text>
                <Text style={{ fontSize: 22, color: '#B7CBDD', lineHeight: 1.6 }}>
                    把一片鼻腔 CT，变成一组<span style={{ color: '#E8F1FA', fontWeight: 600 }}>可出示给医生看的客观功能数字</span>——鼻阻力、壁面剪应力、后鼻孔温湿度。
                </Text>
                <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'center' }}>
                    <Box style={{ padding: '6px 14px', borderRadius: 999, background: 'rgba(34,211,238,0.12)', border: '1px solid rgba(34,211,238,0.42)' }}>
                        <Text style={{ fontSize: 14, color: '#7DE3F4' }}>空鼻症（ENS）功能评估</Text>
                    </Box>
                    <Box style={{ padding: '6px 14px', borderRadius: 999, background: 'rgba(245,165,36,0.10)', border: '1px solid rgba(245,165,36,0.40)' }}>
                        <Text style={{ fontSize: 14, color: '#F5A524' }}>全链路可复现</Text>
                    </Box>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'column', alignItems: 'flex-end', gap: 18, width: 320 }}>
                <Box style={{ flexDirection: 'column', alignItems: 'flex-end', gap: 4 }}>
                    <Text style={{ fontSize: 30, fontWeight: 700, color: '#E8F1FA', lineHeight: 1.2 }}>CT → 网格 → 求解</Text>
                    <Text style={{ fontSize: 15, color: '#B7CBDD' }}>单命令全自动链路</Text>
                </Box>
                <Box style={{ width: 210, height: 1, background: 'rgba(139,166,193,0.26)' }} />
                <Box style={{ flexDirection: 'column', alignItems: 'flex-end', gap: 4 }}>
                    <Text style={{ fontSize: 30, fontWeight: 700, color: '#E8F1FA', lineHeight: 1.2 }}>3 类功能指标</Text>
                    <Text style={{ fontSize: 15, color: '#B7CBDD' }}>对应患者三大主诉</Text>
                </Box>
                <Box style={{ width: 210, height: 1, background: 'rgba(139,166,193,0.26)' }} />
                <Box style={{ flexDirection: 'column', alignItems: 'flex-end', gap: 4 }}>
                    <Text style={{ fontSize: 30, fontWeight: 700, color: '#E8F1FA', lineHeight: 1.2 }}>4 周</Text>
                    <Text style={{ fontSize: 15, color: '#B7CBDD' }}>从 0 到可复现交付</Text>
                </Box>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', borderTop: '1px solid rgba(139,166,193,0.28)', paddingTop: 20 }}>
            <Text style={{ fontSize: 14, color: '#8BA6C1' }}>医疗健康创新赛</Text>
            <Text style={{ fontSize: 14, color: '#8BA6C1' }}>2026.10 · 全链路验证</Text>
        </Box>
    </Box>
</Slide>
