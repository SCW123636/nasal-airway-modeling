                    <Text style={{ fontSize: 26, fontWeight: 700, color: '#22D3EE', width: 44 }}>03</Text>
                    <Text style={{ fontSize: 23, fontWeight: 700, color: '#E8F1FA', width: 250 }}>一个月的协作故事</Text>
